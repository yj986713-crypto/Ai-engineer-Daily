import sqlite3

DB_NAME = "store_inventory.db"

def initialize_db():
    """Creates the inventory database table if it does not exist."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS products (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL UNIQUE,
            quantity INTEGER NOT NULL,
            price REAL NOT NULL,
            min_stock INTEGER NOT NULL
        )
    """)
    conn.commit()
    conn.close()

def add_product():
    """Inserts a new product or updates stock if it already exists."""
    print("\n--- Add / Restock Product ---")
    name = input("Enter product name: ").strip().title()
    if not name:
        print("Product name cannot be empty.")
        return

    try:
        quantity = int(input("Enter quantity to add: "))
        price = float(input("Enter unit price: ₹"))
        min_stock = int(input("Enter low-stock alert threshold: "))
    except ValueError:
        print("❌ Invalid numeric input.")
        return

    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    # Check if product already exists
    cursor.execute("SELECT id, quantity FROM products WHERE name = ?", (name,))
    existing = cursor.fetchone()

    if existing:
        new_qty = existing[1] + quantity
        cursor.execute("UPDATE products SET quantity = ?, price = ? WHERE id = ?", (new_qty, price, existing[0]))
        print(f"✅ Restocked '{name}'. New total quantity: {new_qty}")
    else:
        cursor.execute(
            "INSERT INTO products (name, quantity, price, min_stock) VALUES (?, ?, ?, ?)",
            (name, quantity, price, min_stock)
        )
        print(f"✅ Added new product '{name}' to database.")

    conn.commit()
    conn.close()

def view_inventory():
    """Displays all items in the database with stock status alerts."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT id, name, quantity, price, min_stock FROM products")
    rows = cursor.fetchall()
    conn.close()

    print("\n=========================================================================")
    print("                         STORE INVENTORY DATABASE                        ")
    print("=========================================================================")
    if not rows:
        print("Database is empty. Add products to begin.")
        return

    print(f"{'ID':<5} | {'Product Name':<22} | {'Qty':<6} | {'Price':<10} | {'Status'}")
    print("-" * 73)

    for row in rows:
        p_id, name, qty, price, min_stock = row
        status = "⚠️ LOW STOCK" if qty <= min_stock else "✅ IN STOCK"
        print(f"{p_id:<5} | {name:<22} | {qty:<6} | ₹{price:<9.2f} | {status}")

def record_sale():
    """Deducts sold units from the database safely."""
    view_inventory()
    try:
        p_id = int(input("\nEnter Product ID sold: "))
        sold_qty = int(input("Enter units sold: "))
    except ValueError:
        print("❌ Please enter valid numbers.")
        return

    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT name, quantity FROM products WHERE id = ?", (p_id,))
    product = cursor.fetchone()

    if not product:
        print("❌ Product ID not found.")
    elif sold_qty <= 0:
        print("❌ Sold quantity must be greater than zero.")
    elif sold_qty > product[1]:
        print(f"❌ Insufficient stock! Only {product[1]} units available.")
    else:
        new_qty = product[1] - sold_qty
        cursor.execute("UPDATE products SET quantity = ? WHERE id = ?", (new_qty, p_id))
        conn.commit()
        print(f"💰 Sale recorded! {sold_qty}x '{product[0]}' sold. Remaining stock: {new_qty}")

    conn.close()

def main():
    initialize_db()

    while True:
        print("\n=============================")
        print("   SQL INVENTORY MANAGER     ")
        print("=============================")
        print("1. View Inventory & Alerts")
        print("2. Add / Restock Product")
        print("3. Record a Sale")
        print("4. Exit")

        choice = input("Select an option (1-4): ").strip()

        if choice == "1":
            view_inventory()
        elif choice == "2":
            add_product()
        elif choice == "3":
            record_sale()
        elif choice == "4":
            print("\nDatabase saved safely. Goodbye! 📦")
            break
        else:
            print("Invalid choice. Please enter 1 to 4.")

if __name__ == "__main__":
    main()
                   
