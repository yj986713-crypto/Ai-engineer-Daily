import http.server
import socketserver
import webbrowser

PORT = 8085

# Multi-Language Mix: Designing a visually sleek front-end app interface
html_layout = """<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Focus Dashboard</title>
    <!-- CSS Language for responsive alignment and glowing active indicators -->
    <style>
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .timer-card {
            background-color: #1e293b;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            text-align: center;
            width: 380px;
            border: 1px solid #334155;
        }
        h2 { margin-top: 0; color: #38bdf8; font-size: 24px; letter-spacing: 1px; }
        .timer-display {
            font-size: 72px;
            font-weight: 700;
            color: #ffffff;
            margin: 20px 0;
            font-family: monospace;
            text-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
        }
        .controls button {
            padding: 12px 28px;
            margin: 0 8px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-start { background-color: #10b981; color: white; }
        .btn-start:hover { background-color: #059669; }
        .btn-reset { background-color: #ef4444; color: white; }
        .btn-reset:hover { background-color: #dc2626; }
        .status-tag {
            display: inline-block;
            padding: 6px 16px;
            background-color: #334155;
            color: #94a3b8;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .status-tag.work { background-color: rgba(249, 115, 22, 0.2); color: #fb923c; }
    </style>
</head>
<body>

    <div class="timer-card">
        <div class="status-tag work" id="statusLabel">⏱️ Focus Session</div>
        <h2>Pomodoro Productivity Hub</h2>
        <div class="timer-display" id="timeDisplay">25:00</div>
        
        <div class="controls">
            <button class="btn-start" id="startBtn" onclick="toggleTimer()">Start</button>
            <button class="btn-reset" onclick="resetTimer()">Reset</button>
        </div>
    </div>

    <!-- JavaScript Language Mix for client-side interval calculations -->
    <script>
        let timeLeft = 25 * 60; // 25 minutes standard setup
        let timerInterval = null;
        let isWorking = true;

        function updateDisplay() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            document.getElementById('timeDisplay').innerText = 
                `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function toggleTimer() {
            const startBtn = document.getElementById('startBtn');
            
            if (timerInterval) {
                // Pause current instance
                clearInterval(timerInterval);
                timerInterval = null;
                startBtn.innerText = "Start";
                startBtn.style.backgroundColor = "#10b981";
            } else {
                // Initialize background tick logic
                startBtn.innerText = "Pause";
                startBtn.style.backgroundColor = "#eab308";
                
                timerInterval = setInterval(() => {
                    if (timeLeft > 0) {
                        timeLeft--;
                        updateDisplay();
                    } else {
                        // Switch between focus and break block phases automatically
                        clearInterval(timerInterval);
                        timerInterval = null;
                        startBtn.innerText = "Start";
                        startBtn.style.backgroundColor = "#10b981";
                        
                        isWorking = !isWorking;
                        if (isWorking) {
                            timeLeft = 25 * 60;
                            document.getElementById('statusLabel').innerText = "⏱️ Focus Session";
                            document.getElementById('statusLabel').className = "status-tag work";
                        } else {
                            timeLeft = 5 * 60; // 5 minute break rule
                            document.getElementById('statusLabel').innerText = "☕ Short Break";
                            document.getElementById('statusLabel').className = "status-tag";
                        }
                        updateDisplay();
                        alert(isWorking ? "Break is over! Time to focus." : "Focus session complete! Take a break.");
                    }
                }, 1000);
            }
        }

        function resetTimer() {
            clearInterval(timerInterval);
            timerInterval = null;
            isWorking = true;
            timeLeft = 25 * 60;
            document.getElementById('statusLabel').innerText = "⏱️ Focus Session";
            document.getElementById('statusLabel').className = "status-tag work";
            document.getElementById('startBtn').innerText = "Start";
            document.getElementById('startBtn').style.backgroundColor = "#10b981";
            updateDisplay();
        }

        updateDisplay();
    </script>
</body>
</html>
"""

# Establish the index static template file path locally
with open("index.html", "w", encoding="utf-8") as f:
    f.write(html_layout)

class CustomServerHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass # Drop incoming active logging details for clean script output

print(f"🚀 Initializing Python Web Engine on http://localhost:{PORT}")
webbrowser.open(f"http://localhost:{PORT}")

with socketserver.TCPServer(("", PORT), CustomServerHandler) as httpd:
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping background local development cluster safely.")

      
