import http.server
import socketserver
import os
import webbrowser

PORT = 8000

# Multi-Language Mix: Creating the Frontend (HTML, CSS, JavaScript) as a file
html_content = """<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Interactive Converter</title>
    <!-- CSS Language for clean layout and dark mode styling -->
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .converter-card {
            background-color: #1e1e1e;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
            text-align: center;
            width: 350px;
        }
        h2 { color: #00adb5; margin-bottom: 20px; }
        input, select {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            border-radius: 6px;
            border: 1px solid #333;
            background-color: #2d2d2d;
            color: white;
            font-size: 16px;
        }
        button {
            width: 96%;
            padding: 12px;
            background-color: #00adb5;
            border: none;
            color: white;
            font-size: 16px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: 0.2s;
        }
        button:hover { background-color: #007a80; }
        .result {
            margin-top: 20px;
            font-size: 20px;
            font-weight: bold;
            color: #00adb5;
        }
    </style>
</head>
<body>

    <div class="converter-card">
        <h2>💱 Crypto & Fiat Converter</h2>
        <input type="number" id="amount" value="1" placeholder="Enter amount">
        
        <select id="fromCurrency">
            <option value="USD">USD (US Dollar)</option>
            <option value="BTC">BTC (Bitcoin)</option>
            <option value="ETH">ETH (Ethereum)</option>
        </select>

        <p style="margin: 5px; color: #888;">to</p>

        <select id="toCurrency">
            <option value="INR" selected>INR (Indian Rupee)</option>
            <option value="USD">USD (US Dollar)</option>
            <option value="EUR">EUR (Euro)</option>
        </select>

        <button onclick="convertCurrency()">Convert Live</button>
        <div class="result" id="outputResult">₹87.50 INR</div>
    </div>

    <!-- JavaScript Language Mix for live client-side math calculations -->
    <script>
        function convertCurrency() {
            const amount = parseFloat(document.getElementById('amount').value) || 0;
            const from = document.getElementById('fromCurrency').value;
            const to = document.getElementById('toCurrency').value;
            
            // Hardcoded exchange baseline rates (1 USD equivalents)
            const ratesInUSD = {
                "USD": 1.0,
                "INR": 87.50, // 1 USD = 87.50 INR
                "EUR": 0.92,  // 1 USD = 0.92 EUR
                "BTC": 0.000011, // 1 USD = fractional Bitcoin
                "ETH": 0.00035   // 1 USD = fractional Ethereum
            };

            // Calculate conversions securely via baseline dollar math
            let amountInUSD;
            if (from === "BTC") amountInUSD = amount / ratesInUSD["BTC"];
            else if (from === "ETH") amountInUSD = amount / ratesInUSD["ETH"];
            else amountInUSD = amount; // already USD

            let finalResult = amountInUSD * ratesInUSD[to];
            
            // Format currency symbol symbols visually
            let symbol = to === "INR" ? "₹" : to === "EUR" ? "€" : "$";
            document.getElementById('outputResult').innerText = symbol + finalResult.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 4}) + " " + to;
        }
    </script>
</body>
</html>
"""

# Write out the UI workspace index
with open("index.html", "w", encoding="utf-8") as f:
    f.write(html_content)

# Start backend local web server instance
class MyHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        pass # Keep console clean

print(f"🚀 Starting Python Web Server on http://localhost:{PORT}")
webbrowser.open(f"http://localhost:{PORT}")

with socketserver.TCPServer(("", PORT), MyHandler) as httpd:
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping Web Server. Goodbye!")
